# robro-jp 環境変数テンプレート
# .env.local にコピーして値を埋める。Vercel には各値を Project Settings > Environment Variables に登録する。
# ※ このファイルに実際の値（キー・シークレット）を書かないこと。

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cron / 内部 ----
CRON_SECRET=
FINGERPRINT_SALT=

# ---- 管理画面 Basic 認証（middleware.ts）----
# 未設定だと /admin と /api/admin は 503 になる（通すより閉じる方針）
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- 機能フラグ（拡張ガイドライン#6：段階リリース）----
NEXT_PUBLIC_FEATURE_PROMOTION=false
NEXT_PUBLIC_FEATURE_STRATEGY_TIPS=false

# ---- AdSense（フェーズ12 / lib/ads.ts）----
# 広告表示そのものの ON/OFF。'true' 以外は広告枠を一切描画しない。
NEXT_PUBLIC_FEATURE_ADS=false

# パブリッシャーID。未設定なら lib/ads.ts の既定値を使う。
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-5811589837476935

# 年齢別の広告取り扱い（AdSense: tag for age treatment）
#   '0' = 指定なし（パーソナライズ広告が有効）… 現在の設定（2026-08 Yuki 判断・収益優先）
#   '2' = 18歳未満扱い（パーソナライズ広告を出さない）
#   '1' = 13歳未満扱い
NEXT_PUBLIC_ADSENSE_AGE_TREATMENT=0

# 広告ユニットのスロットID。
# AdSense 管理画面 > 広告 > 広告ユニットごと でディスプレイ広告を作ると発行される数字列。
# 未設定の枠は描画されない（IDが揃う前にデプロイしても安全）。
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_GAME_DETAIL=
